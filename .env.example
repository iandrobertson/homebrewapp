# Local development template. Copy to .env and replace every change-me value.
# Generate secrets with: openssl rand -base64 32

POSTGRES_USER=brew_root
POSTGRES_PASSWORD=change-me
POSTGRES_DB=homebrew
POSTGRES_PORT=5433

BREW_MIGRATE_PASSWORD=change-me
BREW_AUTH_PASSWORD=change-me
BREW_APP_PASSWORD=change-me

DATABASE_URL_MIGRATE=postgresql://brew_migrate:change-me@localhost:5433/homebrew
DATABASE_URL_AUTH=postgresql://brew_auth:change-me@localhost:5433/homebrew
DATABASE_URL_APP=postgresql://brew_app:change-me@localhost:5433/homebrew

BETTER_AUTH_SECRET=change-me-generate-a-real-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000

AUDIT_IP_SALT=change-me-generate-a-real-salt

NODE_ENV=development
